#include <stdio.h>
#include <string.h>

int main() {
    char s[1001];
    scanf("%[^\n]", s);
    
    // Get the first "token" (word)
    char *token = strtok(s, " ");
    
    // Continue getting tokens until none are left
    while (token != NULL) {
        printf("%s\n", token);
        token = strtok(NULL, " ");
    }
    
    return 0;
}
