#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    // The size of the square grid is (2*n - 1)
    int len = 2 * n - 1;
    
    // Loop through each row
    for (int i = 0; i < len; i++) {
        // Loop through each column
        for (int j = 0; j < len; j++) {
            
            // Calculate distance to all four edges
            int min_dist = i; // distance to top
            if (j < min_dist) min_dist = j; // distance to left
            if (len - 1 - i < min_dist) min_dist = len - 1 - i; // distance to bottom
            if (len - 1 - j < min_dist) min_dist = len - 1 - j; // distance to right
            
            // The value is n minus the minimum distance
            printf("%d ", n - min_dist);
        }
        // Move to the next line after each row
        printf("\n");
    }
    
    return 0;
}
