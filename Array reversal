#include <stdio.h>
#include <stdlib.h>

int main() {
    int n;
    // Step 1: Read the size of the array
    if (scanf("%d", &n) != 1) return 1;

    // Step 2: Dynamically allocate memory
    int *arr = (int*)malloc(n * sizeof(int));
    
    // Step 3: Input values
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Step 4: Reverse the array in-place
    int start = 0;
    int end = n - 1;
    while (start < end) {
        // Swap logic using a temporary variable
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        
        // Move pointers closer to the center
        start++;
        end--;
    }

    // Step 5: Print the reversed array
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    // Step 6: Free the memory
    free(arr);
    
    return 0;
}
