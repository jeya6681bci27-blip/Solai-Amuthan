#include <stdio.h>

int main() {
    int n, sum = 0;
    
    // Read the five-digit integer
    scanf("%d", &n);
    
    // Use a loop to extract each digit
    while (n > 0) {
        // Add the last digit to sum
        sum += (n % 10);
        
        // Remove the last digit from n
        n = n / 10;
    }
    
    // Print the final sum
    printf("%d\n", sum);
    
    return 0;
}
