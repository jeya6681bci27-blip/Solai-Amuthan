#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    // Allocate memory for the string (max 1000 characters)
    char *s = malloc(1001 * sizeof(char));
    
    // Read the string (handles alphabets and digits)
    if (scanf("%s", s) != 1) return 0;

    // Create a frequency array for digits 0-9 and initialize to 0
    int freq[10] = {0};

    // Iterate through the string
    for (int i = 0; s[i] != '\0'; i++) {
        // Check if the character is a digit
        if (s[i] >= '0' && s[i] <= '9') {
            // Increment the specific index
            // ASCII subtraction: 'digit' - '0' gives the integer value
            freq[s[i] - '0']++;
        }
    }

    // Print the frequencies separated by spaces
    for (int i = 0; i < 10; i++) {
        printf("%d ", freq[i]);
    }
    printf("\n");

    free(s);
    return 0;
}
