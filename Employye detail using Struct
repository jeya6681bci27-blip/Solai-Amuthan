1)	#include <stdio.h>

struct Employee {
    int id;
    char name[50];
    float basic, hra, da, gross;
};

int main() {
    int n, i;
    printf("Enter number of employees: ");
    scanf("%d", &n);

    struct Employee emp[n];
    int highestIndex = 0;

    for(i = 0; i < n; i++) {
        printf("\nEnter details for Employee %d\n", i + 1);
        printf("ID: "); scanf("%d", &emp[i].id);
        printf("Name: "); scanf("%s", emp[i].name);
        printf("Basic Salary: "); scanf("%f", &emp[i].basic);
        printf("HRA: "); scanf("%f", &emp[i].hra);
        printf("DA: "); scanf("%f", &emp[i].da);

        // Compute Gross Salary
        emp[i].gross = emp[i].basic + emp[i].hra + emp[i].da;

        // Track highest paid
        if(emp[i].gross > emp[highestIndex].gross) {
            highestIndex = i;
        }
    }

    printf("\n--- Highest Paid Employee ---\n");
    printf("Name: %s\nID: %d\nGross Salary: %.2f\n", 
            emp[highestIndex].name, emp[highestIndex].id, emp[highestIndex].gross);

    return 0;
}
