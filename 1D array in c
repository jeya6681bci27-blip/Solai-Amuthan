#include <stdio.h>
#include <stdlib.h>

int main() {
    int n;
    long long sum = 0; // Using long long to prevent overflow for large sums

    // Step 1: Read the size of the array
    if (scanf("%d", &n) != 1) return 1;

    // Step 2: Dynamically allocate memory for n integers
    // malloc takes the total number of bytes needed: (count * size of one element)
    int *arr = (int*)malloc(n * sizeof(int));

    // Safety check: ensure memory was actually allocated
    if (arr == NULL) {
        return 1; 
    }

    // Step 3: Read n integers into the array
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Step 4: Iterate through the array and calculate the sum
    for (int i = 0; i < n; i++) {
        sum += arr[i];
    }

    // Step 5: Print the result
    printf("%lld\n", sum);

    // Step 6: Free the allocated memory
    free(arr);

    return 0;
}
